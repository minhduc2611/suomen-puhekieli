{
  "name": "puhu-suomee",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Spoken Finnish (puhekieli) conversation course",
  "scripts": {
    "content": "node tools/build-content.mjs",
    "audio": "node tools/build-audio.mjs",
    "icons": "node tools/make-icons.mjs",
    "verify": "node tools/verify.mjs",
    "dev": "npm run content && vite",
    "build": "npm run content && vite build",
    "preview": "vite preview",
    "deploy": "VITE_NO_AUDIO_PACK=1 npm run build && rm -rf dist/audio && npx netlify-cli deploy --prod --dir=dist"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
